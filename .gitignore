# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Environments
.env
.env.local
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Local databases and run artifacts
*.db
*.db-*
*.duckdb
*.duckdb.wal
*.parquet
*.sqlite3
*.log
data/
# ...but cardcenter/data is package data (standards.json, species.json), not a
# run artifact. standards.json predates the rule above and so was tracked
# anyway; without this negation the next data file added there is silently
# dropped from the package instead.
!cardcenter/data/
out.png
out.json
scan_results/
uploads/

# Private trainer tier. The real root lives outside the repo
# (BAKUGO_PRIVATE_ROOT; trainer/paths.py refuses an in-repo root). These
# patterns only catch accidents.
bakugo-private/
private_data/
trainer_data/
drive_listing.json
rclone.conf
*.rclone.conf
review-*.jsonl
*.key
# Staging directories left by an interrupted `python -m trainer release`
cardcenter/data/released/*.staging/
cardcenter/data/released/*.previous/

# IDE and OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
