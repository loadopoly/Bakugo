# syntax=docker/dockerfile:1
# Bakugo private trainer. Never published, never attached to the tunnel.
# Used by the `trainer-sync` (network: trainer_egress) and `trainer`
# (network_mode: none) services in docker-compose.yml, profile `trainer`.

FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        tesseract-ocr \
        libglib2.0-0 \
        libgomp1 \
        rclone \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 10002 trainer \
    && useradd --system --uid 10002 --gid trainer --home-dir /home/trainer \
        --create-home --shell /usr/sbin/nologin trainer

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/home/trainer \
    BAKUGO_PRIVATE_ROOT=/private \
    CARDCENTER_QUIPU_DISABLE=1

RUN pip install --no-cache-dir "numpy>=1.24" "opencv-python-headless>=4.8" \
        "duckdb>=1.0.0" "pypdfium2>=4.0" "pillow>=10.0" "pytesseract>=0.3.10"

COPY pyproject.toml README.md ./
COPY cardcenter/ ./cardcenter/
COPY ingest/ ./ingest/
COPY eval/ ./eval/
COPY trainer/ ./trainer/
RUN pip install --no-cache-dir --no-deps .

USER trainer
ENTRYPOINT ["python", "-m", "trainer"]
CMD ["status"]
